import 'dotenv/config';
import express from 'express';
import session from 'express-session';
import connectPgSimple from 'connect-pg-simple';
import helmet from 'helmet';
import cors from 'cors';
import { z } from 'zod';
import { randomUUID } from 'node:crypto';

import { pool, db } from './db.js';
import { audit } from './audit.js';
import {
  PASSWORD_POLICY,
  validatePassword,
  hashPassword,
  verifyPassword,
  generateTempPassword,
  recordLoginAttempt,
  isLoginRateLimited,
  requireAuth,
  requireRole,
  requirePasswordChanged,
  ROLES
} from './auth.js';

// ---- Startup validation ----
const REQUIRED = ['SESSION_SECRET', 'DATABASE_URL'];
for (const key of REQUIRED) {
  if (!process.env[key]) {
    console.error(`FATAL: ${key} is not set. Aborting.`);
    process.exit(1);
  }
}
if (process.env.SESSION_SECRET.length < 32) {
  console.error('FATAL: SESSION_SECRET must be at least 32 characters. Aborting.');
  process.exit(1);
}

const PORT = Number(process.env.PORT || 4000);
const FRONTEND_ORIGIN = process.env.FRONTEND_ORIGIN || 'http://127.0.0.1:5173';
const IS_PROD = process.env.NODE_ENV === 'production';

const app = express();
app.set('trust proxy', 1);
app.use(helmet({ crossOriginResourcePolicy: { policy: 'cross-origin' } }));
app.use(express.json({ limit: '256kb' }));
app.use(cors({ origin: FRONTEND_ORIGIN, credentials: true }));

// ---- Session ----
const PgStore = connectPgSimple(session);
app.use(session({
  store: new PgStore({ pool, tableName: 'session', createTableIfMissing: false }),
  name: 'mediflow.sid',
  secret: process.env.SESSION_SECRET,
  resave: false,
  saveUninitialized: false,
  rolling: true,
  cookie: {
    httpOnly: true,
    sameSite: 'lax',
    secure: IS_PROD,
    maxAge: 8 * 60 * 60 * 1000 // 8 hours
  }
}));

// ---- Helpers ----
const wrap = (fn) => (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);

async function loadUserForSession(userId) {
  const { rows } = await pool.query(
    `SELECT id, name, email, role, status, must_change_password
       FROM users WHERE id = $1`,
    [userId]
  );
  return rows[0] || null;
}

// ---- Public: health + auth ----

app.get('/api/health', wrap(async (_req, res) => {
  const db = await pool.query('SELECT version() AS v');
  res.json({
    status: 'ok',
    app: 'MediFlow Pharmacy API',
    database: db.rows[0].v.split(' ').slice(0, 2).join(' '),
    time: new Date().toISOString()
  });
}));

app.post('/api/auth/login', wrap(async (req, res) => {
  const input = z.object({
    email: z.string().email().max(200),
    password: z.string().min(1).max(200)
  }).parse(req.body);

  const email = input.email.toLowerCase();
  const ip = req.ip;

  if (await isLoginRateLimited(email, ip)) {
    return res.status(429).json({
      error: `Too many failed attempts. Try again in ${15} minutes.`
    });
  }

  const { rows } = await pool.query(
    `SELECT id, name, email, password_hash, role, status, must_change_password
       FROM users WHERE email = $1`,
    [email]
  );
  const user = rows[0];

  const ok = user && user.status === 'ACTIVE'
    && (await verifyPassword(input.password, user.password_hash));

  await recordLoginAttempt(email, ip, !!ok);

  if (!ok) {
    // Don't leak which condition failed.
    return res.status(401).json({ error: 'Email or password is incorrect.' });
  }

  await pool.query('UPDATE users SET last_login_at = now() WHERE id = $1', [user.id]);
  await audit.run(user.id, 'LOGIN', 'user', user.id);

  req.session.regenerate((err) => {
    if (err) return res.status(500).json({ error: 'Could not create session.' });
    req.session.user = {
      id: user.id,
      name: user.name,
      email: user.email,
      role: user.role,
      mustChangePassword: !!user.must_change_password
    };
    res.json({
      user: req.session.user,
      passwordPolicy: PASSWORD_POLICY
    });
  });
}));

app.post('/api/auth/logout', requireAuth, (req, res) => {
  const uid = req.session.user.id;
  req.session.destroy(async () => {
    res.clearCookie('mediflow.sid');
    await audit.run(uid, 'LOGOUT', 'user', uid);
    res.json({ ok: true });
  });
});

app.get('/api/auth/me', wrap(async (req, res) => {
  if (!req.session?.user) return res.json({ user: null });
  // Refresh from DB so role/status changes take effect without re-login.
  const fresh = await loadUserForSession(req.session.user.id);
  if (!fresh || fresh.status !== 'ACTIVE') {
    req.session.destroy(() => {});
    return res.json({ user: null });
  }
  req.session.user = {
    id: fresh.id,
    name: fresh.name,
    email: fresh.email,
    role: fresh.role,
    mustChangePassword: !!fresh.must_change_password
  };
  res.json({ user: req.session.user });
}));

app.post('/api/auth/change-password', requireAuth, wrap(async (req, res) => {
  const input = z.object({
    currentPassword: z.string().min(1).max(200),
    newPassword: z.string().min(1).max(200)
  }).parse(req.body);

  const uid = req.session.user.id;
  const { rows } = await pool.query(
    'SELECT email, password_hash FROM users WHERE id = $1',
    [uid]
  );
  const user = rows[0];
  if (!user) return res.status(404).json({ error: 'User not found.' });

  const ok = await verifyPassword(input.currentPassword, user.password_hash);
  if (!ok) return res.status(401).json({ error: 'Current password is incorrect.' });

  const policyError = validatePassword(input.newPassword, user.email);
  if (policyError) return res.status(422).json({ error: policyError });

  if (input.newPassword === input.currentPassword) {
    return res.status(422).json({ error: 'New password must differ from current password.' });
  }

  const hash = await hashPassword(input.newPassword);
  await pool.query(
    `UPDATE users
        SET password_hash = $1,
            must_change_password = false
      WHERE id = $2`,
    [hash, uid]
  );
  await audit.run(uid, 'CHANGE_PASSWORD', 'user', uid);

  req.session.user.mustChangePassword = false;
  res.json({ ok: true });
}));

// ---- Routes below this line require a normal (non-temp-password) session ----
const gate = [requireAuth, requirePasswordChanged];

app.get('/api/dashboard', ...gate, wrap(async (_req, res) => {
  const medicines = (await pool.query(`
    SELECT m.*, COALESCE(SUM(b.quantity),0)::int AS stock
    FROM medicines m LEFT JOIN batches b ON b.medicine_id = m.id
    GROUP BY m.id ORDER BY m.name`)).rows;
  const lowStock = medicines.filter((m) => m.stock <= m.reorder_level);
  const near = (await pool.query(`
    SELECT b.*, m.name AS medicine_name, m.sku FROM batches b
    JOIN medicines m ON m.id = b.medicine_id
    WHERE b.quantity > 0 AND b.expiry_date >= CURRENT_DATE
      AND b.expiry_date <= CURRENT_DATE + INTERVAL '90 days'
    ORDER BY b.expiry_date`)).rows;
  const expired = (await pool.query(`
    SELECT b.*, m.name AS medicine_name, m.sku FROM batches b
    JOIN medicines m ON m.id = b.medicine_id
    WHERE b.quantity > 0 AND b.expiry_date < CURRENT_DATE
    ORDER BY b.expiry_date`)).rows;
  const salesToday = (await pool.query(`
    SELECT COALESCE(SUM(total),0)::float AS total, COUNT(*)::int AS count
    FROM sales WHERE created_at::date = CURRENT_DATE`)).rows[0];
  const recentSales = (await pool.query(`
    SELECT s.*, m.name AS medicine_name FROM sales s
    JOIN medicines m ON m.id = s.medicine_id
    ORDER BY s.id DESC LIMIT 8`)).rows;
  res.json({
    metrics: {
      medicineCount: medicines.length,
      stockUnits: medicines.reduce((s, m) => s + m.stock, 0),
      lowStock: lowStock.length,
      outOfStock: medicines.filter((m) => m.stock === 0).length,
      nearExpiry: near.length,
      expiredValue: expired.reduce((s, b) => s + b.quantity * Number(b.cost_price), 0),
      salesToday: Number(salesToday.total),
      transactionsToday: Number(salesToday.count)
    },
    lowStock: lowStock.slice(0, 8),
    nearExpiry: near.slice(0, 8),
    expired: expired.slice(0, 8),
    recentSales
  });
}));

