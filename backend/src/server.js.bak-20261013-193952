app.get('/api/medicines', ...gate, wrap(async (req, res) => {
  const q = String(req.query.q || '').trim();
  const { rows } = await pool.query(`
    SELECT m.*, COALESCE(SUM(b.quantity),0)::int AS stock
    FROM medicines m LEFT JOIN batches b ON b.medicine_id = m.id
    WHERE m.name ILIKE $1 OR m.sku ILIKE $1
    GROUP BY m.id ORDER BY m.name`, [`%${q}%`]);
  res.json(rows);
}));

app.post('/api/medicines', requireAuth, requirePasswordChanged,
  requireRole('OWNER', 'PHARMACIST'), wrap(async (req, res) => {
  const m = z.object({
    name: z.string().min(2).max(200),
    sku: z.string().regex(/^[A-Za-z0-9_-]+$/).max(60),
    category: z.string().min(1).max(100),
    unit: z.string().min(1).max(30),
    reorder_level: z.coerce.number().int().min(0).max(1_000_000)
  }).parse(req.body);

  const { rows } = await pool.query(`
    INSERT INTO medicines (name, sku, category, unit, reorder_level)
    VALUES ($1,$2,$3,$4,$5) RETURNING *`,
    [m.name, m.sku, m.category, m.unit, m.reorder_level]);

  await audit.run(req.session.user.id, 'CREATE', 'medicine', rows[0].id);
  res.status(201).json(rows[0]);
}));

app.delete('/api/medicines/:id', requireAuth, requirePasswordChanged,
  requireRole('OWNER'), wrap(async (req, res) => {
  const id = Number(req.params.id);
  const { rows } = await pool.query(
    'SELECT COUNT(*)::int AS n FROM sales WHERE medicine_id = $1', [id]);
  if (rows[0].n > 0) {
    return res.status(409).json({ error: 'Medicine has sales history and cannot be deleted.' });
  }
  await pool.query('DELETE FROM medicines WHERE id = $1', [id]);
  await audit.run(req.session.user.id, 'DELETE', 'medicine', id);
  res.json({ ok: true });
}));

