app.post('/api/users', requireAuth, requirePasswordChanged,
  requireRole('OWNER'), wrap(async (req, res) => {
  const input = z.object({
    name: z.string().min(2).max(120),
    email: z.string().email().max(200),
    role: z.enum(ROLES)
  }).parse(req.body);

  const email = input.email.toLowerCase();
  const exists = (await pool.query(
    'SELECT id FROM users WHERE email = $1', [email])).rows[0];
  if (exists) return res.status(409).json({ error: 'Email already in use.' });

  const tempPassword = generateTempPassword();
  const policyError = validatePassword(tempPassword, email);
  if (policyError) return res.status(500).json({ error: 'Internal password policy failure.' });

  const hash = await hashPassword(tempPassword);
  const { rows } = await pool.query(`
    INSERT INTO users (name, email, password_hash, role, status,
                       must_change_password, created_by)
    VALUES ($1,$2,$3,$4,'ACTIVE', true, $5)
    RETURNING id, name, email, role, status, must_change_password, created_at`,
    [input.name, email, hash, input.role, req.session.user.id]);

  await audit.run(req.session.user.id, 'CREATE', 'user', rows[0].id);

  // Temp password returned exactly once — owner must deliver it out-of-band.
  res.status(201).json({
    user: rows[0],
    tempPassword,
    note: 'Share this password privately. The user must change it on first login.'
  });
}));

app.patch('/api/users/:id', requireAuth, requirePasswordChanged,
  requireRole('OWNER'), wrap(async (req, res) => {
  const id = Number(req.params.id);
  const input = z.object({
    name: z.string().min(2).max(120).optional(),
    role: z.enum(ROLES).optional(),
    status: z.enum(['ACTIVE', 'SUSPENDED']).optional()
  }).parse(req.body);

  if (id === req.session.user.id && input.status === 'SUSPENDED') {
    return res.status(422).json({ error: 'You cannot suspend your own account.' });
  }

  const target = (await pool.query(
    'SELECT id, role, status FROM users WHERE id = $1', [id])).rows[0];
  if (!target) return res.status(404).json({ error: 'User not found.' });

  // Guard: at least one ACTIVE OWNER must remain.
  const willRemoveLastOwner =
    target.role === 'OWNER' &&
    ((input.role && input.role !== 'OWNER') || input.status === 'SUSPENDED');
  if (willRemoveLastOwner) {
    const { rows } = await pool.query(
      `SELECT COUNT(*)::int AS n FROM users
        WHERE role = 'OWNER' AND status = 'ACTIVE' AND id <> $1`, [id]);
    if (rows[0].n === 0) {
      return res.status(422).json({
        error: 'There must always be at least one active OWNER.'
      });
    }
  }

  const fields = [];
  const values = [];
  let i = 1;
  for (const [k, v] of Object.entries(input)) {
    if (v !== undefined) { fields.push(`${k} = $${i++}`); values.push(v); }
  }
  if (fields.length === 0) return res.json({ ok: true, unchanged: true });

  values.push(id);
  const { rows } = await pool.query(
    `UPDATE users SET ${fields.join(', ')}
      WHERE id = $${i}
      RETURNING id, name, email, role, status, must_change_password, created_at, last_login_at`,
    values);

  await audit.run(req.session.user.id, 'UPDATE', 'user', id);
  res.json(rows[0]);
}));

app.post('/api/users/:id/reset-password', requireAuth, requirePasswordChanged,
  requireRole('OWNER'), wrap(async (req, res) => {
  const id = Number(req.params.id);
  const target = (await pool.query(
    'SELECT id, email FROM users WHERE id = $1', [id])).rows[0];
  if (!target) return res.status(404).json({ error: 'User not found.' });

  const tempPassword = generateTempPassword();
  const hash = await hashPassword(tempPassword);
  await pool.query(
    `UPDATE users
        SET password_hash = $1,
            must_change_password = true
      WHERE id = $2`,
    [hash, id]);

  await audit.run(req.session.user.id, 'RESET_PASSWORD', 'user', id);
  res.json({
    tempPassword,
    note: 'Deliver this password privately. The user must change it on next login.'
  });
}));

// ---- Error handler ----
app.use((err, _req, res, _next) => {
  if (err instanceof z.ZodError) {
    return res.status(400).json({
      error: 'Please check the submitted fields.',
      details: err.issues.map((i) => ({ path: i.path.join('.'), message: i.message }))
    });
  }
  if (err.code === '23505') {
    return res.status(409).json({ error: 'That value already exists.' });
  }
  console.error(err);
  res.status(err.status || 500).json({
    error: err.status ? err.message : 'Unexpected server error.'
  });
});

const server = app.listen(PORT, () =>
  console.log(`MediFlow API listening on http://localhost:${PORT}`));

// ---- Graceful shutdown ----
for (const sig of ['SIGINT', 'SIGTERM']) {
  process.on(sig, async () => {
    console.log(`\n[shutdown] ${sig} received, closing…`);
    server.close(async () => {
      try { await pool.end(); } catch {}
      process.exit(0);
    });
    // Failsafe
    setTimeout(() => process.exit(1), 5000).unref();
  });
}
