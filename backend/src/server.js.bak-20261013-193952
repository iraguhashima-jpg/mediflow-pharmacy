app.post('/api/batches', requireAuth, requirePasswordChanged,
  requireRole('OWNER', 'PHARMACIST'), wrap(async (req, res) => {
  const b = z.object({
    medicine_id: z.coerce.number().int().positive(),
    batch_number: z.string().min(1).max(80),
    quantity: z.coerce.number().int().min(0).max(10_000_000),
    expiry_date: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
    cost_price: z.coerce.number().min(0).max(1e9),
    selling_price: z.coerce.number().min(0).max(1e9)
  }).parse(req.body);

  const exists = (await pool.query(
    'SELECT id FROM medicines WHERE id = $1', [b.medicine_id])).rows[0];
  if (!exists) return res.status(404).json({ error: 'Medicine not found.' });

  const { rows } = await pool.query(`
    INSERT INTO batches (medicine_id, batch_number, quantity, expiry_date, cost_price, selling_price)
    VALUES ($1,$2,$3,$4,$5,$6) RETURNING *`,
    [b.medicine_id, b.batch_number, b.quantity, b.expiry_date, b.cost_price, b.selling_price]);

  await audit.run(req.session.user.id, 'RECEIVE_STOCK', 'batch', rows[0].id);
  res.status(201).json(rows[0]);
}));

// ---- Sales ----
app.post('/api/sales', requireAuth, requirePasswordChanged,
  requireRole('OWNER', 'PHARMACIST', 'STAFF'), wrap(async (req, res) => {
  const input = z.object({
    batch_id: z.coerce.number().int().positive(),
    quantity: z.coerce.number().int().positive().max(100_000)
  }).parse(req.body);

  const result = await db.transaction(async (tx) => {
    const batch = (await tx.query(`
      SELECT b.*, m.name AS medicine_name FROM batches b
      JOIN medicines m ON m.id = b.medicine_id
      WHERE b.id = $1 FOR UPDATE`, [input.batch_id])).rows[0];
    if (!batch) { const e = new Error('Batch not found.'); e.status = 404; throw e; }
    const today = new Date().toISOString().slice(0, 10);
    if (batch.expiry_date < today) {
      const e = new Error('Expired stock cannot be sold.'); e.status = 409; throw e;
    }
    if (batch.quantity < input.quantity) {
      const e = new Error('Not enough stock in this batch.'); e.status = 409; throw e;
    }

    await tx.query(
      'UPDATE batches SET quantity = quantity - $1 WHERE id = $2',
      [input.quantity, batch.id]);

    const total = Number((Number(batch.selling_price) * input.quantity).toFixed(2));
    const receipt = `MF-${Date.now()}-${randomUUID().slice(0, 6).toUpperCase()}`;

    const sale = (await tx.query(`
      INSERT INTO sales (receipt_number, medicine_id, batch_id, quantity, unit_price, total, sold_by)
      VALUES ($1,$2,$3,$4,$5,$6,$7) RETURNING *`,
      [receipt, batch.medicine_id, batch.id, input.quantity,
       batch.selling_price, total, req.session.user.id])).rows[0];

    await tx.query(
      `INSERT INTO audit_logs (user_id, action, entity, entity_id)
       VALUES ($1,'SALE','sale',$2)`,
      [req.session.user.id, sale.id]);

    return {
      id: sale.id,
      receipt_number: sale.receipt_number,
      medicine_name: batch.medicine_name,
      quantity: sale.quantity,
      unit_price: Number(sale.unit_price),
      total: Number(sale.total),
      created_at: sale.created_at
    };
  });

  res.status(201).json(result);
}));

